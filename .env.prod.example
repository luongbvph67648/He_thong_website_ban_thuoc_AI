# Sao chép thành .env.prod và điền giá trị THẬT. KHÔNG commit .env.prod.
# Backend từ chối khởi động khi MOI_TRUONG=production mà còn cổng giả, thiếu bí mật hoặc COOKIE_SECURE=false (QĐ-53).
# Chưa có tài khoản VNPay/MoMo/GHN/SMS thật (xem README mục Triển khai): đặt MOI_TRUONG=dev để chạy bản demo với
# adapter giả (khi đó THANH_TOAN_CHE_DO=gia, VAN_CHUYEN_CHE_DO=gia, TIN_NHAN_CHE_DO=gia) và KHÔNG dùng dữ liệu khách thật.
MOI_TRUONG=production
POSTGRES_PASSWORD=
WEB_PORT=80

# Địa chỉ công khai (HTTPS) của website: dùng cho CORS, cookie và liên kết trong email/SMS
FRONTEND_URL=https://nhathuoc.example.com
CORS_ORIGINS=https://nhathuoc.example.com
COOKIE_SECURE=true

# Bí mật: JWT >= 32 ký tự ngẫu nhiên; khóa Fernet sinh bằng
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
KHOA_MA_HOA=

# Admin đầu tiên (chỉ cần ở lần migrate đầu; phải đổi mật khẩu khi đăng nhập lần đầu)
ADMIN_EMAIL=
ADMIN_MAT_KHAU=

# AI
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_GIA_LAP=false
AI_NGAN_SACH_NGAY_USD=5
EMBEDDING_GIA_LAP=true

# Tích hợp THẬT (production không chạy được với chế độ giả)
THANH_TOAN_CHE_DO=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_RETURN_URL=
MOMO_IPN_URL=
VAN_CHUYEN_CHE_DO=ghn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_URL=
GHN_WEBHOOK_TOKEN=
TIN_NHAN_CHE_DO=that
SMTP_HOST=
SMTP_PORT=587
