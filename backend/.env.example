# Sao chép thành `backend/.env` rồi sửa. File `.env` đã được gitignore, KHÔNG commit.
# Toàn bộ giá trị dưới đây là giá trị giả cho môi trường dev. Danh sách biến theo docs/spec/01-kien-truc.md mục 5.

# --- Cơ sở dữ liệu ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nha_thuoc
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/nha_thuoc_test

# --- Xác thực ---
# Đổi thành chuỗi ngẫu nhiên >= 32 ký tự: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
JWT_ACCESS_PHUT=15
REFRESH_NGAY=14
# Cookie refresh token có cờ Secure (chỉ gửi qua https). Chỉ đặt false khi dev qua http (trình duyệt vẫn chấp nhận
# Secure trên localhost, nhưng công cụ như curl thì không).
# MOI_TRUONG=production từ chối khởi động nếu còn cổng giả, thiếu bí mật hoặc COOKIE_SECURE=false
MOI_TRUONG=dev
COOKIE_SECURE=false

# --- Frontend / CORS (nhiều origin cách nhau bằng dấu phẩy) ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Tài khoản Admin đầu tiên (dùng cho seed) ---
# Bắt buộc ở lần seed đầu. Mật khẩu tối thiểu 12 ký tự, có chữ và số; giá trị mẫu bắt đầu bằng "doi-" bị từ chối.
ADMIN_EMAIL=admin@example.com
ADMIN_MAT_KHAU=doi-mat-khau-nay-123

# --- Mã hóa hồ sơ sức khỏe (khóa Fernet) ---
# Sinh khóa: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KHOA_MA_HOA=

# --- AI (Claude API) ---
# Chỉ cần ANTHROPIC_API_KEY khi AI_GIA_LAP=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_GIA_LAP=true
# Đơn giá USD / 1 triệu token của model đang dùng, để tính hoi_thoai.chi_phi
AI_GIA_INPUT=4
AI_GIA_OUTPUT=20
AI_GIA_CACHE_READ=0.20
# Vượt ngưỡng này thì tạm tắt chat AI trong ngày
AI_NGAN_SACH_NGAY_USD=2

# --- Embedding ---
EMBEDDING_MODEL=BAAI/bge-m3
# true = vector giả xác định; false cần cài nhóm phụ thuộc ai-local
EMBEDDING_GIA_LAP=true

# --- Thanh toán (gia | mo_phong | sandbox) ---
# mo_phong = adapter VNPay/MoMo thật chạy với máy chủ mô phỏng đúng giao thức trong ứng dụng (không cần tài khoản đối tác,
# không có tiền thật; khóa mặc định tự điền). gia = cổng giả đơn giản dùng cho test. sandbox = VNPay/MoMo thật.
THANH_TOAN_CHE_DO=mo_phong
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=
VNPAY_API_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_REFUND_ENDPOINT=
MOMO_RETURN_URL=
MOMO_IPN_URL=

# --- Vận chuyển (gia | mo_phong | ghn) ---
# mo_phong = adapter GHN thật với GHN mô phỏng trong ứng dụng (kho bấm phát webhook trạng thái đúng khuôn GHN)
VAN_CHUYEN_CHE_DO=mo_phong
GHN_TOKEN=
GHN_SHOP_ID=
GHN_URL=
GHN_WEBHOOK_TOKEN=

# --- SMS / email (gia = ghi log + Mailpit; that = nhà cung cấp thật) ---
TIN_NHAN_CHE_DO=gia
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Lưu file ---
LUU_TRU_THU_MUC=./storage
# Chuỗi ngẫu nhiên dùng ký URL file riêng tư
