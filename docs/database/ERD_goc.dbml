// CSDL Website nhà thuốc trực tuyến tích hợp AI


Project nha_thuoc {
  database_type: 'PostgreSQL'
  Note: '''
  Quy ước:
  - Thời gian lưu UTC (timestamptz). Tiền dùng decimal.
  - Tồn kho lưu theo LÔ và theo ĐƠN VỊ CƠ SỞ (viên, gói, ống...).
  - Tồn khả dụng = so_luong_ton - so_luong_giu, chỉ tính lô trạng thái dang_ban.
  - Cột deleted_at = xóa mềm.
  - Các ràng buộc CHECK, extension pgvector/unaccent/pg_trgm và index HNSW
    cần viết thêm trong migration (xem ghi chú từng bảng).
  '''
}

// =====================================================================
// ENUM
// =====================================================================

Enum loai_san_pham {
  thuoc_ke_don [note: 'Không thêm thẳng vào giỏ, chỉ bán qua luồng duyệt đơn thuốc']
  thuoc_khong_ke_don
  thuc_pham_chuc_nang
  duoc_my_pham
  thiet_bi_y_te
}

Enum trang_thai_kinh_doanh {
  dang_kinh_doanh
  ngung_kinh_doanh
}

Enum trang_thai_noi_dung {
  nhap
  da_duyet [note: 'Chỉ nội dung đã duyệt mới hiển thị và đưa vào kho tri thức AI']
  luu_tru
}

Enum trang_thai_lo {
  dang_ban
  can_han [note: 'HSD còn dưới ngưỡng cấu hình, không dùng cho đơn online']
  khoa
  het_han
  thu_hoi
}

Enum trang_thai_don {
  cho_khach_xac_nhan [note: 'Đơn tạo từ đơn thuốc (DS05), chờ khách xác nhận']
  cho_thanh_toan
  cho_xac_nhan
  da_xac_nhan
  dang_soan_hang
  cho_lay_hang [note: 'Chờ shipper lấy, hoặc chờ khách đến nhận tại nhà thuốc']
  dang_giao
  da_giao
  hoan_tat
  giao_that_bai
  hoan_ve_kho
  da_huy
  doi_tra
}

Enum kenh_ban {
  online
  dien_thoai
  tai_quay
}

Enum hinh_thuc_nhan {
  giao_tan_noi
  nhan_tai_nha_thuoc
}

Enum phuong_thuc_thanh_toan {
  cod
  vnpay
  momo
  tien_mat
  chuyen_khoan
}

Enum trang_thai_thanh_toan {
  chua_thanh_toan
  da_thanh_toan
  cho_hoan_tien
  da_hoan_tien
}

Enum loai_giao_dich {
  thanh_toan
  hoan_tien
}

Enum trang_thai_giao_dich {
  khoi_tao
  thanh_cong
  that_bai
}

Enum trang_thai_phan_bo {
  dang_giu [note: 'Đã giữ hàng trên lô, chưa trừ tồn thật']
  da_xuat [note: 'Đã trừ tồn thật khi soạn hàng']
  da_nha [note: 'Đơn hủy trước khi xuất, đã nhả giữ']
  da_hoan_nhap [note: 'Đơn hủy sau khi xuất, đã trả về đúng lô']
}

Enum trang_thai_yeu_cau_don_thuoc {
  cho_duyet
  dang_tu_van
  da_tao_don
  tu_choi
  khach_huy
}

Enum trang_thai_duyet {
  cho_duyet
  da_duyet
  tu_choi
}

Enum ly_do_huy_hang {
  het_han
  hu_hong
  hang_tra_ve
  thu_hoi
  khac
}

Enum ly_do_doi_tra {
  giao_sai_san_pham
  sai_so_luong
  hu_hong
  het_han_can_han
  khac
}

Enum trang_thai_doi_tra {
  cho_duyet
  da_duyet
  tu_choi
  kho_da_nhan
  hoan_tat
}

Enum huong_xu_ly_doi_tra {
  hoan_tien
  gui_hang_thay_the
}

Enum loai_giam_gia {
  phan_tram
  so_tien
}

Enum pham_vi_khuyen_mai {
  toan_bo
  danh_muc
  san_pham
}

Enum trang_thai_tai_khoan {
  hoat_dong
  bi_khoa
}

Enum trang_thai_kiem_ke {
  dang_kiem
  da_chot
}

Enum trang_thai_thu_hoi {
  dang_thu_hoi
  hoan_tat
}

Enum ket_qua_lien_he_thu_hoi {
  chua_lien_he
  da_lien_he
  da_hen_tra_hang
  da_thu_ve
  khong_lien_lac_duoc
}

Enum loai_hoi_thoai {
  ai
  duoc_si
}

Enum trang_thai_hoi_thoai {
  dang_mo
  cho_duoc_si
  duoc_si_dang_xu_ly
  cho_goi_lai
  da_dong
}

Enum vai_tro_tin_nhan {
  khach
  ai
  duoc_si
  he_thong
}

Enum nguon_tri_thuc {
  san_pham
  bai_viet
  chinh_sach
  faq
}

// =====================================================================
// NHÓM SẢN PHẨM
// =====================================================================

Table danh_muc [headercolor: #0F6E56] {
  id int [pk, increment]
  ten varchar(150) [not null]
  slug varchar(180) [not null, unique]
  danh_muc_cha_id int [ref: > danh_muc.id, note: 'Null = danh mục gốc, tối đa 3 cấp']
  anh_url varchar(500)
  thu_tu int [not null, default: 0]
  dang_hien_thi boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz
}

Table thuong_hieu [headercolor: #0F6E56] {
  id int [pk, increment]
  ten varchar(150) [not null, unique]
  logo_url varchar(500)
  created_at timestamptz [not null, default: `now()`]
}

Table nha_san_xuat [headercolor: #0F6E56] {
  id int [pk, increment]
  ten varchar(200) [not null]
  quoc_gia varchar(100)
  created_at timestamptz [not null, default: `now()`]
}

Table hoat_chat [headercolor: #0F6E56] {
  id int [pk, increment]
  ten varchar(200) [not null, unique, note: 'Tên chuẩn, VD: Paracetamol']
  ten_khac text [note: 'Tên đồng nghĩa phục vụ tìm kiếm, VD: Acetaminophen']
  mo_ta text
  created_at timestamptz [not null, default: `now()`]
}

Table san_pham [headercolor: #0F6E56] {
  id int [pk, increment]
  sku varchar(50) [not null, unique]
  ten varchar(255) [not null]
  slug varchar(280) [not null, unique]
  loai_san_pham loai_san_pham [not null]
  danh_muc_id int [not null, ref: > danh_muc.id]
  thuong_hieu_id int [ref: > thuong_hieu.id]
  nha_san_xuat_id int [ref: > nha_san_xuat.id]
  so_dang_ky varchar(50) [note: 'Số đăng ký lưu hành, dùng để nhận diện ảnh hộp thuốc']
  dang_bao_che varchar(100) [note: 'Viên nén, siro, gói bột...']
  quy_cach varchar(150) [note: 'VD: Hộp 10 vỉ x 10 viên']
  doi_tuong_su_dung varchar(150) [note: 'Trẻ em, người lớn... dùng cho bộ lọc']
  don_vi_co_so varchar(30) [not null, note: 'Đơn vị nhỏ nhất: viên, gói, ống, chai']
  ton_toi_thieu int [not null, default: 0, note: 'Theo đơn vị cơ sở, dùng cho cảnh báo HT02']
  dung_dinh_ky boolean [not null, default: false, note: 'Dùng cho nhắc mua lại KTV14']
  so_ngay_dung_moi_don_vi decimal(6,2)
  trang_thai trang_thai_kinh_doanh [not null, default: 'dang_kinh_doanh']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  indexes {
    so_dang_ky
    (danh_muc_id, trang_thai)
    loai_san_pham
  }
  Note: 'Migration: thêm index GIN pg_trgm trên unaccent(ten) cho tìm kiếm sai chính tả, không dấu'
}

Table thanh_phan [headercolor: #0F6E56] {
  san_pham_id int [not null, ref: > san_pham.id]
  hoat_chat_id int [not null, ref: > hoat_chat.id]
  ham_luong varchar(50) [note: 'VD: 500mg']

  indexes {
    (san_pham_id, hoat_chat_id) [pk]
    hoat_chat_id
  }
}

Table don_vi_quy_doi [headercolor: #0F6E56] {
  id int [pk, increment]
  san_pham_id int [not null, ref: > san_pham.id]
  ten_don_vi varchar(30) [not null, note: 'Hộp, vỉ, viên...']
  he_so int [not null, note: 'Số đơn vị cơ sở trong 1 đơn vị này. Đơn vị cơ sở có he_so = 1']
  gia_ban decimal(14,2) [not null]
  ban_online boolean [not null, default: true, note: 'false = chỉ bán tại quầy']
  la_mac_dinh boolean [not null, default: false]
  ma_vach varchar(50)

  indexes {
    (san_pham_id, ten_don_vi) [unique]
    ma_vach
  }
  Note: 'CHECK (he_so >= 1), CHECK (gia_ban >= 0)'
}

Table thong_tin_chuyen_mon [headercolor: #0F6E56] {
  id int [pk, increment]
  san_pham_id int [not null, ref: > san_pham.id]
  phien_ban int [not null, default: 1]
  chi_dinh text
  chong_chi_dinh text
  lieu_dung_tham_khao text
  tac_dung_phu text
  than_trong text
  tuong_tac_thuoc text
  phu_nu_co_thai_cho_con_bu text
  tre_em text
  qua_lieu_xu_tri text
  bao_quan text
  file_hdsd_url varchar(500) [note: 'Tờ hướng dẫn sử dụng gốc']
  trang_thai trang_thai_noi_dung [not null, default: 'nhap']
  nguoi_soan_id int [ref: > nhan_vien.id]
  duoc_si_duyet_id int [ref: > nhan_vien.id]
  ngay_duyet timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (san_pham_id, phien_ban) [unique]
    (san_pham_id, trang_thai)
  }
  Note: 'Mỗi lần sửa tạo phiên bản mới. Phiên bản hiển thị = phiên bản da_duyet mới nhất (DS10)'
}

Table anh_san_pham [headercolor: #0F6E56] {
  id int [pk, increment]
  san_pham_id int [not null, ref: > san_pham.id]
  url varchar(500) [not null]
  thu_tu int [not null, default: 0]
  la_anh_chinh boolean [not null, default: false]
}

// =====================================================================
// NHÓM KHO
// =====================================================================

Table nha_cung_cap [headercolor: #BA7517] {
  id int [pk, increment]
  ten varchar(200) [not null]
  ma_so_thue varchar(20) [unique]
  dia_chi varchar(500)
  nguoi_lien_he varchar(150)
  so_dien_thoai varchar(20)
  email varchar(150)
  dang_hop_tac boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table lo_thuoc [headercolor: #BA7517] {
  id int [pk, increment]
  san_pham_id int [not null, ref: > san_pham.id]
  so_lo varchar(50) [not null, note: 'Số lô của nhà sản xuất']
  ngay_san_xuat date
  han_su_dung date [not null]
  gia_nhap decimal(14,2) [not null, note: 'Giá vốn trên 1 đơn vị cơ sở']
  so_luong_ton int [not null, default: 0, note: 'Đơn vị cơ sở']
  so_luong_giu int [not null, default: 0, note: 'Đang giữ cho đơn chưa xuất kho']
  trang_thai trang_thai_lo [not null, default: 'dang_ban']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    (san_pham_id, so_lo, han_su_dung) [unique]
    (san_pham_id, trang_thai, han_su_dung) [note: 'Phục vụ chọn lô FEFO']
    han_su_dung
  }
  Note: 'CHECK (so_luong_ton >= 0), CHECK (so_luong_giu >= 0), CHECK (so_luong_giu <= so_luong_ton). Mọi cập nhật tồn dùng SELECT ... FOR UPDATE'
}

Table phieu_nhap [headercolor: #BA7517] {
  id int [pk, increment]
  ma_phieu varchar(30) [not null, unique]
  nha_cung_cap_id int [not null, ref: > nha_cung_cap.id]
  so_hoa_don_ncc varchar(50)
  nhan_vien_id int [not null, ref: > nhan_vien.id]
  ngay_nhap timestamptz [not null, default: `now()`]
  tong_tien decimal(16,2) [not null, default: 0]
  ghi_chu text
  created_at timestamptz [not null, default: `now()`]
}

Table ct_phieu_nhap [headercolor: #BA7517] {
  id int [pk, increment]
  phieu_nhap_id int [not null, ref: > phieu_nhap.id]
  lo_id int [not null, ref: > lo_thuoc.id]
  don_vi_id int [not null, ref: > don_vi_quy_doi.id, note: 'Đơn vị nhập, VD: hộp']
  so_luong int [not null, note: 'Theo đơn vị nhập']
  so_luong_co_so int [not null, note: 'so_luong x he_so']
  gia_nhap decimal(14,2) [not null, note: 'Theo đơn vị nhập']
}

Table phieu_kiem_ke [headercolor: #BA7517] {
  id int [pk, increment]
  ma_phieu varchar(30) [not null, unique]
  danh_muc_id int [ref: > danh_muc.id, note: 'Null = kiểm kê toàn kho']
  nhan_vien_id int [not null, ref: > nhan_vien.id]
  trang_thai trang_thai_kiem_ke [not null, default: 'dang_kiem']
  thoi_diem_chup_ton timestamptz [not null, default: `now()`]
  chot_luc timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table ct_kiem_ke [headercolor: #BA7517] {
  id int [pk, increment]
  phieu_kiem_ke_id int [not null, ref: > phieu_kiem_ke.id]
  lo_id int [not null, ref: > lo_thuoc.id]
  so_luong_so_sach int [not null]
  so_luong_thuc_te int
  chenh_lech int [note: 'thuc_te - so_sach']

  indexes {
    (phieu_kiem_ke_id, lo_id) [unique]
  }
}

Table phieu_dieu_chinh [headercolor: #BA7517] {
  id int [pk, increment]
  ma_phieu varchar(30) [not null, unique]
  phieu_kiem_ke_id int [ref: > phieu_kiem_ke.id]
  ly_do text [not null]
  trang_thai_duyet trang_thai_duyet [not null, default: 'cho_duyet']
  nguoi_lap_id int [not null, ref: > nhan_vien.id]
  nguoi_duyet_id int [ref: > nhan_vien.id]
  ly_do_tu_choi text
  duyet_luc timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'CHECK (nguoi_duyet_id <> nguoi_lap_id). Tồn chỉ thay đổi khi da_duyet'
}

Table ct_phieu_dieu_chinh [headercolor: #BA7517] {
  id int [pk, increment]
  phieu_dieu_chinh_id int [not null, ref: > phieu_dieu_chinh.id]
  lo_id int [not null, ref: > lo_thuoc.id]
  so_luong_thay_doi int [not null, note: 'Dương = tăng, âm = giảm (đơn vị cơ sở)']
}

Table phieu_huy [headercolor: #BA7517] {
  id int [pk, increment]
  ma_phieu varchar(30) [not null, unique]
  ly_do ly_do_huy_hang [not null]
  mo_ta text
  bien_ban_url varchar(500)
  trang_thai_duyet trang_thai_duyet [not null, default: 'cho_duyet']
  nguoi_lap_id int [not null, ref: > nhan_vien.id]
  nguoi_duyet_id int [ref: > nhan_vien.id]
  ly_do_tu_choi text
  duyet_luc timestamptz
  created_at timestamptz [not null, default: `now()`]
  Note: 'CHECK (nguoi_duyet_id <> nguoi_lap_id)'
}

Table ct_phieu_huy [headercolor: #BA7517] {
  id int [pk, increment]
  phieu_huy_id int [not null, ref: > phieu_huy.id]
  lo_id int [not null, ref: > lo_thuoc.id]
  so_luong int [not null, note: 'Đơn vị cơ sở']
}

Table lenh_thu_hoi [headercolor: #BA7517] {
  id int [pk, increment]
  ma_lenh varchar(30) [not null, unique]
  san_pham_id int [not null, ref: > san_pham.id]
  lo_id int [not null, ref: > lo_thuoc.id]
  can_cu varchar(255) [not null, note: 'Số công văn hoặc thông báo thu hồi']
  muc_do varchar(50)
  trang_thai trang_thai_thu_hoi [not null, default: 'dang_thu_hoi']
  nguoi_tao_id int [not null, ref: > nhan_vien.id]
  created_at timestamptz [not null, default: `now()`]
  dong_luc timestamptz
}

Table ct_lenh_thu_hoi [headercolor: #BA7517] {
  id int [pk, increment]
  lenh_thu_hoi_id int [not null, ref: > lenh_thu_hoi.id]
  don_hang_id int [not null, ref: > don_hang.id]
  khach_hang_id int [ref: > khach_hang.id]
  so_luong_da_ban int [not null, note: 'Đơn vị cơ sở, lấy từ phan_bo_lo']
  so_luong_da_thu_ve int [not null, default: 0]
  ket_qua_lien_he ket_qua_lien_he_thu_hoi [not null, default: 'chua_lien_he']
  ghi_chu text
  nhan_vien_id int [ref: > nhan_vien.id, note: 'Dược sĩ liên hệ (DS13)']
  cap_nhat_luc timestamptz

  indexes {
    (lenh_thu_hoi_id, don_hang_id) [unique]
  }
}

Table phieu_xuat_tra [headercolor: #BA7517] {
  id int [pk, increment]
  ma_phieu varchar(30) [not null, unique]
  nha_cung_cap_id int [not null, ref: > nha_cung_cap.id]
  lenh_thu_hoi_id int [ref: > lenh_thu_hoi.id]
  ly_do text [not null]
  nhan_vien_id int [not null, ref: > nhan_vien.id]
  da_xac_nhan boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}

Table ct_phieu_xuat_tra [headercolor: #BA7517] {
  id int [pk, increment]
  phieu_xuat_tra_id int [not null, ref: > phieu_xuat_tra.id]
  lo_id int [not null, ref: > lo_thuoc.id]
  so_luong int [not null, note: 'Đơn vị cơ sở']
}

// =====================================================================
// NHÓM BÁN HÀNG
// =====================================================================

Table gio_hang [headercolor: #185FA5] {
  id int [pk, increment]
  khach_hang_id int [not null, unique, ref: - khach_hang.id]
  updated_at timestamptz [not null, default: `now()`]
}

Table ct_gio_hang [headercolor: #185FA5] {
  id int [pk, increment]
  gio_hang_id int [not null, ref: > gio_hang.id]
  san_pham_id int [not null, ref: > san_pham.id]
  don_vi_id int [not null, ref: > don_vi_quy_doi.id]
  so_luong int [not null]

  indexes {
    (gio_hang_id, san_pham_id, don_vi_id) [unique]
  }
  Note: 'API phải từ chối sản phẩm loại thuoc_ke_don'
}

Table don_hang [headercolor: #185FA5] {
  id int [pk, increment]
  ma_don varchar(20) [not null, unique]
  khach_hang_id int [ref: > khach_hang.id, note: 'Null = khách lẻ tại quầy']
  kenh_ban kenh_ban [not null, default: 'online']
  hinh_thuc_nhan hinh_thuc_nhan [not null, default: 'giao_tan_noi']
  trang_thai trang_thai_don [not null]
  phuong_thuc_tt phuong_thuc_thanh_toan [not null]
  trang_thai_tt trang_thai_thanh_toan [not null, default: 'chua_thanh_toan']
  yeu_cau_don_thuoc_id int [ref: - yeu_cau_don_thuoc.id, note: 'Bắt buộc nếu đơn có thuốc kê đơn']
  ma_giam_gia_id int [ref: > ma_giam_gia.id]
  tam_tinh decimal(16,2) [not null]
  giam_gia decimal(16,2) [not null, default: 0]
  phi_van_chuyen decimal(14,2) [not null, default: 0]
  tong_tien decimal(16,2) [not null]
  ten_nguoi_nhan varchar(150)
  sdt_nguoi_nhan varchar(20)
  dia_chi_giao varchar(500) [note: 'Bản chụp địa chỉ tại thời điểm đặt']
  ma_tinh varchar(20) [note: 'Mã hành chính theo đơn vị vận chuyển']
  ma_quan_huyen varchar(20)
  ma_phuong_xa varchar(20)
  ghi_chu text
  ly_do_huy text
  nhan_vien_tao_id int [ref: > nhan_vien.id, note: 'Đơn tạo hộ, POS, đơn từ đơn thuốc']
  nhan_vien_xac_nhan_id int [ref: > nhan_vien.id]
  han_thanh_toan timestamptz [note: 'HT03 hủy đơn quá hạn']
  han_xac_nhan timestamptz [note: 'Đơn từ đơn thuốc: hết hạn giữ hàng']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    (trang_thai, created_at)
    (khach_hang_id, created_at)
    sdt_nguoi_nhan
  }
  Note: 'Chỉ service máy trạng thái (HT06) được đổi cột trang_thai'
}

Table ct_don_hang [headercolor: #185FA5] {
  id int [pk, increment]
  don_hang_id int [not null, ref: > don_hang.id]
  san_pham_id int [not null, ref: > san_pham.id]
  don_vi_id int [not null, ref: > don_vi_quy_doi.id]
  ten_san_pham varchar(255) [not null, note: 'Bản chụp tại thời điểm bán']
  ten_don_vi varchar(30) [not null]
  he_so int [not null]
  so_luong int [not null, note: 'Theo đơn vị bán']
  don_gia decimal(14,2) [not null, note: 'Giá tại thời điểm bán, không tham chiếu giá hiện tại']
  thanh_tien decimal(16,2) [not null]
}

Table phan_bo_lo [headercolor: #185FA5] {
  id int [pk, increment]
  ct_don_hang_id int [not null, ref: > ct_don_hang.id]
  lo_id int [not null, ref: > lo_thuoc.id]
  so_luong_co_so int [not null]
  gia_von decimal(14,2) [not null, note: 'Bản chụp lo_thuoc.gia_nhap, tính lợi nhuận gộp']
  trang_thai trang_thai_phan_bo [not null, default: 'dang_giu']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    lo_id [note: 'Truy vết thu hồi theo lô']
    ct_don_hang_id
  }
  Note: 'Chìa khóa cho FEFO, truy vết thu hồi và giá vốn theo lô'
}

Table lich_su_trang_thai [headercolor: #185FA5] {
  id bigint [pk, increment]
  don_hang_id int [not null, ref: > don_hang.id]
  tu_trang_thai trang_thai_don
  den_trang_thai trang_thai_don [not null]
  nhan_vien_id int [ref: > nhan_vien.id]
  khach_hang_id int [ref: > khach_hang.id]
  nguon varchar(30) [note: 'nguoi_dung, he_thong, webhook_van_chuyen, ipn_thanh_toan']
  ghi_chu text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (don_hang_id, created_at)
  }
}

Table thanh_toan [headercolor: #185FA5] {
  id int [pk, increment]
  don_hang_id int [not null, ref: > don_hang.id]
  loai loai_giao_dich [not null, default: 'thanh_toan']
  cong_thanh_toan phuong_thuc_thanh_toan [not null]
  so_tien decimal(16,2) [not null]
  ma_giao_dich_cong varchar(100) [unique, note: 'Mã giao dịch của VNPay/MoMo, chống xử lý IPN trùng']
  trang_thai trang_thai_giao_dich [not null, default: 'khoi_tao']
  du_lieu_ipn jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

Table van_don [headercolor: #185FA5] {
  id int [pk, increment]
  don_hang_id int [not null, unique, ref: - don_hang.id]
  don_vi_van_chuyen varchar(30) [not null, note: 'GHN, GHTK']
  ma_van_don varchar(50) [unique]
  phi decimal(14,2)
  khoi_luong_gram int
  trang_thai_doi_tac varchar(50)
  du_lieu_webhook jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

Table yeu_cau_don_thuoc [headercolor: #185FA5] {
  id int [pk, increment]
  ma_yeu_cau varchar(20) [not null, unique]
  khach_hang_id int [ref: > khach_hang.id, note: 'Null = khách vãng lai (KVL08)']
  ho_ten varchar(150) [not null]
  so_dien_thoai varchar(20) [not null]
  anh_don_thuoc jsonb [not null, note: 'Danh sách khóa file trong kho riêng tư']
  hash_anh varchar(128) [note: 'Phát hiện ảnh đơn trùng']
  ghi_chu text
  ket_qua_ai jsonb [note: 'Kết quả đọc ảnh, chỉ để gợi ý']
  trang_thai trang_thai_yeu_cau_don_thuoc [not null, default: 'cho_duyet']
  duoc_si_id int [ref: > nhan_vien.id, note: 'Dược sĩ đang khóa / đã xử lý']
  checklist jsonb [note: 'Kết quả checklist kiểm tra đơn (DS04)']
  ly_do_tu_choi text
  da_su_dung boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  index
  es {
    (trang_thai, created_at)
    hash_anhz
  }
}

Table ct_yeu_cau_don_thuoc [headercolor: #185FA5] {
  id int [pk, increment]
  yeu_cau_id int [not null, ref: > yeu_cau_don_thuoc.id]
  san_pham_id int [ref: > san_pham.id, note: 'Null = chưa khớp sản phẩm trong CSDL']
  ten_thuoc_tren_don varchar(255) [not null]
  ham_luong varchar(50)
  so_luong_ke varchar(50)
  do_tin_cay_ai decimal(4,3) [note: '0 - 1, null nếu dược sĩ nhập tay']
  do_duoc_si_nhap boolean [not null, default: false]
}

Table yeu_cau_doi_tra [headercolor: #185FA5] {
  id int [pk, increment]
  ma_yeu_cau varchar(20) [not null, unique]
  don_hang_id int [not null, ref: > don_hang.id]
  khach_hang_id int [not null, ref: > khach_hang.id]
  ly_do ly_do_doi_tra [not null]
  mo_ta text
  anh jsonb
  trang_thai trang_thai_doi_tra [not null, default: 'cho_duyet']
  huong_xu_ly huong_xu_ly_doi_tra
  duoc_si_id int [ref: > nhan_vien.id]
  nhan_vien_kho_id int [ref: > nhan_vien.id]
  so_tien_hoan decimal(16,2)
  ly_do_tu_choi text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

Table ct_yeu_cau_doi_tra [headercolor: #185FA5] {
  id int [pk, increment]
  yeu_cau_id int [not null, ref: > yeu_cau_doi_tra.id]
  ct_don_hang_id int [not null, ref: > ct_don_hang.id]
  so_luong int [not null]

  indexes {
    (yeu_cau_id, ct_don_hang_id) [unique]
  }
}

Table khuyen_mai [headercolor: #185FA5] {
  id int [pk, increment]
  ten varchar(200) [not null]
  loai_giam loai_giam_gia [not null]
  gia_tri decimal(14,2) [not null, note: '% hoặc số tiền']
  giam_toi_da decimal(14,2) [note: 'Trần khi giảm theo %']
  don_toi_thieu decimal(14,2) [not null, default: 0]
  bat_dau timestamptz [not null]
  ket_thuc timestamptz [not null]
  tong_luot int
  luot_moi_khach int [not null, default: 1]
  pham_vi pham_vi_khuyen_mai [not null, default: 'toan_bo']
  dang_hoat_dong boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Hệ thống tự loại thuốc kê đơn khỏi phạm vi giảm giá'
}

Table khuyen_mai_pham_vi [headercolor: #185FA5] {
  id int [pk, increment]
  khuyen_mai_id int [not null, ref: > khuyen_mai.id]
  danh_muc_id int [ref: > danh_muc.id]
  san_pham_id int [ref: > san_pham.id]
  Note: 'CHECK đúng một trong hai cột danh_muc_id, san_pham_id có giá trị'
}

Table ma_giam_gia [headercolor: #185FA5] {
  id int [pk, increment]
  khuyen_mai_id int [not null, ref: > khuyen_mai.id]
  ma varchar(30) [not null, unique]
  so_luot_da_dung int [not null, default: 0]
}

// =====================================================================
// NHÓM KHÁCH HÀNG
// =====================================================================

Table khach_hang [headercolor: #993556] {
  id int [pk, increment]
  ho_ten varchar(150) [not null]
  email varchar(150) [unique]
  so_dien_thoai varchar(20) [not null, unique]
  mat_khau_hash varchar(255) [not null, note: 'bcrypt hoặc Argon2']
  gioi_tinh varchar(10)
  trang_thai trang_thai_tai_khoan [not null, default: 'hoat_dong']
  so_lan_dang_nhap_sai int [not null, default: 0]
  khoa_den timestamptz
  dong_y_chinh_sach_luc timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz
}

Table dia_chi [headercolor: #993556] {
  id int [pk, increment]
  khach_hang_id int [not null, ref: > khach_hang.id]
  ten_nguoi_nhan varchar(150) [not null]
  so_dien_thoai varchar(20) [not null]
  dia_chi_chi_tiet varchar(300) [not null]
  ma_tinh varchar(20) [not null, note: 'Mã theo danh mục của đơn vị vận chuyển']
  ten_tinh varchar(100)
  ma_quan_huyen varchar(20) [note: 'Có thể trống nếu đơn vị vận chuyển dùng địa chỉ 2 cấp']
  ma_phuong_xa varchar(20) [not null]
  ten_phuong_xa varchar(100)
  la_mac_dinh boolean [not null, default: false]
}

Table ho_so_suc_khoe [headercolor: #993556] {
  khach_hang_id int [pk, ref: - khach_hang.id]
  nam_sinh int
  benh_nen text [note: 'Mã hóa ở mức ứng dụng']
  dang_mang_thai boolean
  dang_cho_con_bu boolean
  dong_y_su_dung boolean [not null, default: false]
  dong_y_luc timestamptz
  updated_at timestamptz
  Note: 'Dữ liệu nhạy cảm: Admin không xem, dược sĩ chỉ xem khi đang xử lý yêu cầu của khách'
}

Table di_ung [headercolor: #993556] {
  khach_hang_id int [not null, ref: > khach_hang.id]
  hoat_chat_id int [not null, ref: > hoat_chat.id]
  ghi_chu varchar(255)

  indexes {
    (khach_hang_id, hoat_chat_id) [pk]
  }
}

Table danh_gia [headercolor: #993556] {
  id int [pk, increment]
  san_pham_id int [not null, ref: > san_pham.id]
  khach_hang_id int [not null, ref: > khach_hang.id]
  ct_don_hang_id int [not null, unique, ref: > ct_don_hang.id, note: 'Mỗi dòng đơn chỉ đánh giá 1 lần']
  so_sao smallint [not null]
  noi_dung text
  anh jsonb
  dang_hien boolean [not null, default: true]
  phan_hoi text
  nhan_vien_phan_hoi_id int [ref: > nhan_vien.id]
  created_at timestamptz [not null, default: `now()`]
  Note: 'CHECK (so_sao BETWEEN 1 AND 5)'
}

Table thong_bao [headercolor: #993556] {
  id bigint [pk, increment]
  khach_hang_id int [ref: > khach_hang.id]
  nhan_vien_id int [ref: > nhan_vien.id]
  loai varchar(50) [not null, note: 'don_hang, don_thuoc, thu_hoi, doi_tra, kho, nhac_mua_lai...']
  tieu_de varchar(255) [not null]
  noi_dung text
  lien_ket varchar(500)
  da_doc boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (khach_hang_id, da_doc)
    (nhan_vien_id, da_doc)
  }
  Note: 'CHECK đúng một trong hai cột khach_hang_id, nhan_vien_id có giá trị'
}

Table ma_otp [headercolor: #993556] {
  id int [pk, increment]
  dich_den varchar(150) [not null, note: 'SĐT hoặc email']
  ma_hash varchar(255) [not null]
  muc_dich varchar(30) [not null, note: 'dang_ky, quen_mat_khau, don_thuoc_khach']
  het_han timestamptz [not null]
  so_lan_thu int [not null, default: 0]
  da_dung boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (dich_den, muc_dich, created_at)
  }
}

// =====================================================================
// NHÓM NHÂN SỰ VÀ HỆ THỐNG
// =====================================================================

Table nhan_vien [headercolor: #534AB7] {
  id int [pk, increment]
  ma_nhan_vien varchar(20) [not null, unique]
  ho_ten varchar(150) [not null]
  email varchar(150) [not null, unique]
  so_dien_thoai varchar(20)
  mat_khau_hash varchar(255) [not null]
  vai_tro_id int [not null, ref: > vai_tro.id]
  trang_thai trang_thai_tai_khoan [not null, default: 'hoat_dong']
  phai_doi_mat_khau boolean [not null, default: true]
  so_lan_dang_nhap_sai int [not null, default: 0]
  khoa_den timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz
}

Table vai_tro [headercolor: #534AB7] {
  id int [pk, increment]
  ma varchar(30) [not null, unique, note: 'PHARMACIST, WAREHOUSE, ADMIN']
  ten varchar(100) [not null]
  mo_ta text
}

Table quyen [headercolor: #534AB7] {
  id int [pk, increment]
  ma varchar(60) [not null, unique, note: 'VD: order.confirm, rx_request.review']
  nhom varchar(50)
  mo_ta varchar(255)
}

Table vai_tro_quyen [headercolor: #534AB7] {
  vai_tro_id int [not null, ref: > vai_tro.id]
  quyen_id int [not null, ref: > quyen.id]
  gioi_han varchar(255) [note: 'Mô tả điều kiện với quyền dạng giới hạn']

  indexes {
    (vai_tro_id, quyen_id) [pk]
  }
  Note: 'Seed theo sheet Quyền (RBAC). Khách vãng lai và khách thành viên kiểm tra quyền trong code, không cần bản ghi ở đây'
}

Table cau_hinh [headercolor: #534AB7] {
  khoa varchar(80) [pk, note: 'VD: nguong_can_han_ngay, thoi_han_doi_tra_ngay']
  gia_tri jsonb [not null]
  mo_ta varchar(255)
  nhan_vien_cap_nhat_id int [ref: > nhan_vien.id]
  updated_at timestamptz [not null, default: `now()`]
}

Table nhat_ky_he_thong [headercolor: #534AB7] {
  id bigint [pk, increment]
  nhan_vien_id int [ref: > nhan_vien.id]
  hanh_dong varchar(30) [not null, note: 'tao, sua, xoa, duyet, dang_nhap...']
  bang varchar(60) [not null]
  ban_ghi_id varchar(60)
  gia_tri_cu jsonb
  gia_tri_moi jsonb
  ip varchar(45)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (bang, ban_ghi_id)
    (nhan_vien_id, created_at)
  }
  Note: 'Chỉ INSERT. Không ghi mật khẩu, OTP, dữ liệu sức khỏe dạng rõ'
}

Table banner [headercolor: #534AB7] {
  id int [pk, increment]
  tieu_de varchar(200)
  anh_url varchar(500) [not null]
  lien_ket varchar(500)
  vi_tri varchar(30) [not null, note: 'trang_chu_chinh, trang_chu_phu...']
  thu_tu int [not null, default: 0]
  bat_dau timestamptz
  ket_thuc timestamptz
  dang_hien boolean [not null, default: true]
}

Table bai_viet [headercolor: #534AB7] {
  id int [pk, increment]
  tieu_de varchar(255) [not null]
  slug varchar(280) [not null, unique]
  noi_dung text [not null]
  anh_bia_url varchar(500)
  tac_gia_id int [not null, ref: > nhan_vien.id]
  trang_thai trang_thai_noi_dung [not null, default: 'nhap']
  dua_vao_ai boolean [not null, default: false]
  duoc_si_duyet_id int [ref: > nhan_vien.id]
  ngay_duyet timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

// =====================================================================
// NHÓM AI
// =====================================================================

Table tai_lieu_tri_thuc [headercolor: #3B6D11] {
  id bigint [pk, increment]
  nguon_loai nguon_tri_thuc [not null]
  nguon_id int [note: 'id của thong_tin_chuyen_mon, bai_viet... tùy nguon_loai']
  san_pham_id int [ref: > san_pham.id]
  truong varchar(50) [note: 'chi_dinh, chong_chi_dinh, lieu_dung_tham_khao...']
  noi_dung text [not null]
  metadata jsonb [note: 'loai_san_pham, can_ke_don, danh_muc...']
  embedding vector(1024) [note: 'Số chiều theo mô hình embedding đã chọn']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (nguon_loai, nguon_id)
    san_pham_id
  }
  Note: 'Migration: CREATE EXTENSION vector; CREATE INDEX ... USING hnsw (embedding vector_cosine_ops). Không lưu giá, tồn kho ở đây'
}

Table hoi_thoai [headercolor: #3B6D11] {
  id bigint [pk, increment]
  ma_phien uuid [not null, unique]
  khach_hang_id int [ref: > khach_hang.id, note: 'Null = khách vãng lai']
  loai loai_hoi_thoai [not null, default: 'ai']
  trang_thai trang_thai_hoi_thoai [not null, default: 'dang_mo']
  duoc_si_id int [ref: > nhan_vien.id]
  tom_tat text [note: 'Tóm tắt khi chuyển dược sĩ (AI04)']
  so_dien_thoai_goi_lai varchar(20)
  bi_gan_co boolean [not null, default: false]
  ly_do_gan_co varchar(100) [note: 'khach_bao_sai, khong_chac_chan, dau_hieu_nguy_hiem']
  ip_hash varchar(128)
  tong_token int [not null, default: 0]
  chi_phi decimal(12,6) [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  dong_luc timestamptz

  indexes {
    (trang_thai, created_at)
    bi_gan_co
  }
}

Table tin_nhan [headercolor: #3B6D11] {
  id bigint [pk, increment]
  hoi_thoai_id bigint [not null, ref: > hoi_thoai.id]
  vai_tro vai_tro_tin_nhan [not null]
  nhan_vien_id int [ref: > nhan_vien.id, note: 'Khi vai_tro = duoc_si']
  noi_dung text [not null]
  y_dinh varchar(50) [note: 'Kết quả phân loại ý định (AI02)']
  san_pham_goi_y jsonb [note: 'Danh sách san_pham_id hiển thị dạng thẻ']
  dau_hieu_nguy_hiem boolean [not null, default: false]
  so_token int
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (hoi_thoai_id, created_at)
  }
}

Table danh_gia_cau_tra_loi [headercolor: #3B6D11] {
  id int [pk, increment]
  tin_nhan_id bigint [not null, ref: > tin_nhan.id]
  nguon varchar(20) [not null, note: 'khach, duoc_si']
  ket_qua varchar(20) [not null, note: 'huu_ich, khong_huu_ich, dung, sai']
  ghi_chu text [note: 'Dược sĩ ghi nội dung đúng (DS12)']
  khach_hang_id int [ref: > khach_hang.id]
  nhan_vien_id int [ref: > nhan_vien.id]
  created_at timestamptz [not null, default: `now()`]
}

Table lich_su_tim_kiem [headercolor: #3B6D11] {
  id bigint [pk, increment]
  khach_hang_id int [ref: > khach_hang.id]
  ma_phien varchar(64)
  tu_khoa varchar(255) [not null]
  che_do varchar(20) [note: 'tu_khoa, hybrid']
  so_ket_qua int [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    so_ket_qua [note: 'Lọc truy vấn không có kết quả']
    created_at
  }
}

Table lich_su_xem [headercolor: #3B6D11] {
  id bigint [pk, increment]
  khach_hang_id int [ref: > khach_hang.id]
  ma_phien varchar(64)
  san_pham_id int [not null, ref: > san_pham.id]
  nguon varchar(30) [note: 'tim_kiem, goi_y_tuong_tu, mua_kem, danh_cho_ban, chat_ai...']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (khach_hang_id, created_at)
    san_pham_id
  }
}

Table luat_mua_kem [headercolor: #3B6D11] {
  san_pham_a_id int [not null, ref: > san_pham.id]
  san_pham_b_id int [not null, ref: > san_pham.id]
  support decimal(8,6) [not null]
  confidence decimal(8,6) [not null]
  lift decimal(10,4) [not null]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (san_pham_a_id, san_pham_b_id) [pk]
  }
  Note: 'Job AI08 tính lại định kỳ từ ct_don_hang'
}

// =====================================================================
// NHÓM BẢNG (hiển thị khung nhóm trên dbdiagram)
// =====================================================================

TableGroup nhom_san_pham {
  danh_muc
  thuong_hieu
  nha_san_xuat
  hoat_chat
  san_pham
  thanh_phan
  don_vi_quy_doi
  thong_tin_chuyen_mon
  anh_san_pham
}

TableGroup nhom_kho {
  nha_cung_cap
  lo_thuoc
  phieu_nhap
  ct_phieu_nhap
  phieu_kiem_ke
  ct_kiem_ke
  phieu_dieu_chinh
  ct_phieu_dieu_chinh
